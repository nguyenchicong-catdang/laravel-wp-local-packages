{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-test",

	// 1. XÓA HOẶC COMMENT DÒNG NÀY (Vì Pages không dùng "main")
	// "main": "src/index.js",

	"compatibility_date": "2026-04-03",
	"compatibility_flags": ["nodejs_compat"],

	// 2. GIỮ NGUYÊN assets để phục vụ file tĩnh trong /public
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// "directory": "./functions",
	},

	// 3. THÊM BIẾN MÔI TRƯỜNG (Để dùng trong code Proxy)
	"vars": {
		"BACKEND_URL": "http://localhost:8000",
	},
}
